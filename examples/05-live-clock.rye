fyne: import\go "fyne"
app: import\go "fyne/app"
widget: import\go "fyne/widget"

lab: widget/label "<date & time>"

go does {
    forever {
        fyne/do does {
            lab .Set-text now .string
        }
        sleep 500
    }
}

w: app/new .Window "Date & Time"
w .Set-content lab
w .Show-and-run
