fyne: import\go "fyne"
app: import\go "fyne/app"
widget: import\go "fyne/widget"

tab: widget/table
    does { [ 10 10 ] }
    does { widget/label "..." }
    fn { i o } {
        r: 1 + i .Row?
        c: 1 + i .Col?
        o .Set-text string r * c
    }

w: app/new .Window "Multiplication table"
w .Resize fyne/size 330.0 400.0
w .Set-content tab
w .Show-and-run
